{
  "name": "greeting-api",
  "version": "1.0.0",
  "description": "문자를 받아 \"안녕하세요, {이름}님\"을 응답하는 간단한 TypeScript API (외부 런타임 의존성 없음, Node.js 내장 http 모듈만 사용)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "node",
    "api"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
